# demo (default) or prod. Trading commands use this; real market data needs prod.
KALSHI_ENV=demo

# Keys are per environment (demo keys only work on demo). Generate at
# kalshi.com -> Account -> API keys; RSA or Ed25519 PEM.
KALSHI_DEMO_API_KEY_ID=
KALSHI_DEMO_PRIVATE_KEY_PATH=
KALSHI_PROD_API_KEY_ID=
KALSHI_PROD_PRIVATE_KEY_PATH=

# Where raw logs, parquet and the ledger live (default ./data)
# PMX_DATA=
